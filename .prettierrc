{
    "plugins": ["prettier-plugin-blade", "@prettier/plugin-php"],
    "overrides": [
        {
            "files": ["*.blade.php"],
            "options": {
                "parser": "blade",
                "bladePhpFormatting": "safe"
            }
        }
    ],
    "useTabs": false,
    "tabWidth": 4,
    "endOfLine": "lf",
    "trailingComma": "es5",
    "semi": true,
    "singleQuote": true,
    "printWidth": 80
}
